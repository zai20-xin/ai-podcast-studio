# ── 供应商兼容层 ─────────────────────────────────────────
# TTS: mimo（supported）| openai_compatible（experimental）
# LLM: freellmapi / openai（supported）| ollama / custom（experimental）
# 完整说明见 README「供应商兼容层」与 backend/app/providers/catalog.py

TTS_PROVIDER=mimo
MIMO_API_KEY=your_mimo_api_key
MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 写稿用 LLM（OpenAI 兼容）
LLM_PROVIDER=freellmapi
LLM_API_KEY=
LLM_BASE_URL=http://localhost:3001/v1
LLM_MODEL=auto
